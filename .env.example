# =============================================================
#  Variables de entorno — ASM-HelpDesk-Cibertec
#  Copia este archivo a `.env` y ajusta los valores.
#  El archivo `.env` NO debe subirse al repositorio.
# =============================================================

# --- PostgreSQL ---
POSTGRES_DB=helpdesk_db
POSTGRES_USER=helpdesk_admin
POSTGRES_PASSWORD=helpdesk_pwd
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# Secreto de firma JWT: passphrase de al menos 32 caracteres
# (o una cadena Base64 que decodifique a 32+ bytes). Cámbialo en producción.
JWT_SECRET=cambiar_esta_clave_en_produccion_minimo_32_caracteres
JWT_EXPIRATION_MS=86400000
# Orígenes permitidos por CORS (para desarrollo sin proxy de Nginx)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=3000
# En Docker el bundle usa `/api` y Nginx lo proxya al backend.
# Solo se necesita para `npm run dev` contra un backend remoto.
# VITE_API_BASE_URL=http://localhost:8080/api

# --- Asistente IA — IBM watsonx.ai ---
# Pega aquí tus credenciales (nunca las escribas en el código ni en Git).
# Si se dejan vacías, el chatbot funciona con el asistente local (sin IA).
WATSONX_ENABLED=true
WATSONX_APIKEY=
WATSONX_URL=https://api.us-south.watsonx.ai.api.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_MODEL=ibm/granite-3-8b-instruct
